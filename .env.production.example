# ── .env de PRODUCCIÓN ─────────────────────────────────────────────────
# Copiá a `.env` en el VPS y completá. NUNCA lo subas al repo.
#   cp .env.production.example .env
#
# Con KORE_ENV=production la app VALIDA esta config al arrancar y se niega a
# levantar si falta un secreto crítico o quedó un default de desarrollo. Si el
# contenedor no arranca, `docker compose logs api` te dice exactamente cuál.
#
# Generá cada secreto con:  openssl rand -hex 32

# App
KORE_ENV=production
KORE_DEBUG=false
KORE_SECRET_KEY=            # OBLIGATORIO, mínimo 32 chars
KORE_API_V1_PREFIX=/api/v1
# ── Dominio y reverse proxy ────────────────────────────────────────────
# El dominio por el que Vercel y los webhooks externos alcanzan la API. El proxy
# rutea por este valor y emite el certificado; sin él, el compose no arranca.
KORE_API_DOMAIN=api.tudominio.com

# Red del reverse proxy existente. En un servidor con EasyPanel es `easypanel`;
# con otro proxy, poné la suya. Si no hay proxy, sacá el bloque `networks` y las
# labels del servicio api en el compose y volvé a un Caddy propio.
PROXY_NETWORK=easypanel

# URL interna que se le pasa a Evolution para su webhook. NO es el dominio
# público: Evolution corre en la misma red Docker que la API, así que ese
# tráfico resuelve internamente y nunca sale a internet.
PUBLIC_BASE_URL=http://api:8000

# ── Secretos de servicio ───────────────────────────────────────────────
# Autoriza POST /tenants. El MISMO valor va en el frontend (Vercel) como
# KORE_PROVISIONING_SECRET. Sin esto, cualquiera se autoprovisiona un tenant
# con API key válida y gasta tu presupuesto de LLM.
KORE_PROVISIONING_SECRET=    # OBLIGATORIO

# Llave de operador para /billing/admin/* (cobros y activaciones manuales).
# No es una API key de tenant: un cliente nunca debe poder usarla.
KORE_ADMIN_API_KEY=

# Cifra las credenciales de integraciones por tenant (password SMTP, tokens).
# Si la dejás vacía se deriva de KORE_SECRET_KEY. Rotarla obliga a los clientes
# a recargar sus credenciales desde el dashboard.
KORE_CREDENTIALS_SECRET=

# ── Base de datos ──────────────────────────────────────────────────────
# El compose arma el DSN con esta password; no la escribas dentro del DSN.
POSTGRES_PASSWORD=           # OBLIGATORIO
EVOLUTION_DB_PASSWORD=       # OBLIGATORIO
KORE_REDIS_URL=redis://redis:6379/0

# Backups (servicio `backup` del compose → ./backups)
BACKUP_RETENTION_DAYS=14

# ── LLM ────────────────────────────────────────────────────────────────
KORE_LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
KORE_OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
KORE_LLM_TIMEOUT_SECONDS=30
KORE_LLM_MAX_RETRIES=2

# ── Webhooks entrantes ─────────────────────────────────────────────────
# Secreto compartido que TODOS los webhooks exigen (?token= o x-webhook-token).
# Sin él, en producción los webhooks responden 503 y no procesan nada.
WEBHOOK_TOKEN=               # OBLIGATORIO
# Opcionales: sobreescriben el genérico para un proveedor puntual.
EVOLUTION_WEBHOOK_TOKEN=
PLAUD_WEBHOOK_TOKEN=

# ── WhatsApp — Evolution (por la red interna de Docker) ────────────────
EVOLUTION_API_URL=http://evolution:8080
EVOLUTION_API_KEY=           # OBLIGATORIO — la misma la usa el servicio evolution
EVOLUTION_INSTANCE=Fausto

# ── Stripe (si vas a cobrar) ───────────────────────────────────────────
# Con STRIPE_API_KEY seteada, STRIPE_WEBHOOK_SECRET pasa a ser obligatorio:
# sin verificar la firma, cualquiera podría postear un "invoice.paid" falso.
# El endpoint es: POST https://api.tudominio.com/api/v1/billing/webhooks/stripe
# Acordate de setear metadata.tenant_id al crear el customer/checkout.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Límites de abuso y de gasto ────────────────────────────────────────
KORE_RATE_LIMIT_ENABLED=true
KORE_RATE_LIMIT_PER_MINUTE=120            # global por IP
KORE_RATE_LIMIT_AGENT_PER_MINUTE=20       # /agents/run, por tenant
KORE_RATE_LIMIT_WEBHOOK_PER_MINUTE=240    # webhooks, por tenant
# Techo mensual de tokens LLM por tenant. 0 = sin límite. Poné un número
# apenas tengas clientes: es el freno ante un loop de mensajes.
KORE_TOKEN_QUOTA_MONTHLY=0

# ── Observabilidad ─────────────────────────────────────────────────────
SENTRY_DSN=
KORE_SENTRY_TRACES_SAMPLE_RATE=0.0

# ── CORS / docs ────────────────────────────────────────────────────────
# El frontend habla con el backend server-side (BFF), así que normalmente esto
# va vacío. Solo completalo si un navegador llama a la API directo.
KORE_CORS_ORIGINS=
# Swagger apagado por defecto en producción. true para reactivarlo.
KORE_DOCS_ENABLED=false

# ── Concurrencia (opcional) ────────────────────────────────────────────
WEB_CONCURRENCY=4
DRAMATIQ_PROCESSES=2
DRAMATIQ_THREADS=8

# NOTA: SMTP, Google Calendar, ElevenLabs y la persona del agente ya NO van acá:
# cada cliente los carga por-tenant desde el dashboard (Integraciones), y se
# guardan cifrados con KORE_CREDENTIALS_SECRET.
